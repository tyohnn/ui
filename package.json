{
    "name": "tyohnn-monorepo",
    "version": "0.0.0",
    "private": true,
    "packageManager": "npm@11.6.2",
    "workspaces": [
        "registry/*",
        "apps/*",
        "packages/*",
        "tooling/*"
    ],
    "scripts": {
        "dev": "turbo dev",
