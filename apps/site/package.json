{
    "name": "@tyohnn/site",
    "version": "0.0.0",
    "private": true,
    "description": "The public tyohnn site: every design system rendering the preview templates in live iframes, the components, a side-by-side compare and the CLI docs. Static export (out/).",
    "scripts": {
        "build-previews": "node scripts/build-previews.mjs",
        "dev": "next dev --port 5210",
        "build": "node scripts/build-previews.mjs && next build",
        "build:site": "next build",
        "serve": "node scripts/serve.mjs --port 5210",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@fontsource-variable/bricolage-grotesque": "^5.3.0",
        "@fontsource-variable/figtree": "^5.3.0",
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/geist-mono": "^5.3.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@fontsource-variable/noto-sans": "^5.3.0",
        "@fontsource-variable/playfair-display": "^5.3.0",
        "next": "16.3.4",
        "pretendard": "^1.3.9",
        "react": "^19.2.1",
        "react-dom": "^19.2.1",
        "@tyohnn/theme": "*"
    },
    "devDependencies": {
        "@tyohnn/build-system": "*",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "typescript": "^5"
    }
}
