{
    "name": "@tyohnn/site",
    "version": "0.0.0",
    "private": true,
    "description": "The public tyohnn site: every design system rendering the preview templates in iframes, and the CLI commands. Static export (out/).",
    "scripts": {
        "build-previews": "node scripts/build-previews.mjs",
        "dev": "next dev --port 5210",
        "build": "node scripts/build-previews.mjs && next build",
        "build:site": "next build",
        "serve": "node scripts/serve.mjs --port 5210",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@fontsource-variable/inter": "^5.3.0",
        "@tyohnn/ui": "*",
        "next": "16.3.4",
        "react": "^19.2.1",
        "react-dom": "^19.2.1"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "4.3.3",
        "@tyohnn/build-system": "*",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "tailwindcss": "4.3.3",
        "typescript": "^5"
    }
}
