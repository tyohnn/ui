{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "allowJs": true,
        "noEmit": true,
        "incremental": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "plugins": [{ "name": "next" }],
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"],
            "@tyohnn/components/*": ["../../registry/ui/components/*"],
            "@tyohnn/lib/*": ["../../registry/ui/lib/*"],
            "@tyohnn/hooks/*": ["../../registry/ui/hooks/*"],
            "@tyohnn/icons": ["../../registry/ui/icons/libraries/hugeicons.tsx"]
        }
    },
    "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts", "next.config.ts"],
    "exclude": ["node_modules", "out", "public"]
}
