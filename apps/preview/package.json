{
    "name": "@tyohnn/preview",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Renders a template with one design system: SYSTEM=<name> (or --system=<name>) picks fonts and icons at start; ?system=<name>&mode=dark|light&template=<name> picks the stylesheet.",
    "scripts": {
        "build-systems": "node ../../tooling/build-system --all",
        "dev": "npm run build-systems && node scripts/vite-system.mjs --port 5173 --strictPort",
        "build": "npm run build-systems && node scripts/vite-system.mjs build",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@tyohnn/ui": "*",
        "lucide-react": "^1.41.0",
        "react": "^19.2.1",
        "react-dom": "^19.2.1"
    },
    "devDependencies": {
        "@fontsource-variable/figtree": "^5.3.0",
        "@fontsource-variable/geist": "^5.3.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@fontsource-variable/noto-sans": "^5.3.0",
        "@fontsource-variable/playfair-display": "^5.3.0",
        "@tyohnn/build-system": "*",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^6.1.1",
        "pretendard": "^1.3.9",
        "typescript": "^5",
        "vite": "8.3.0"
    }
}
