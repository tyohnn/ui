{
    "name": "@tyohnn/preview",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "Renders a template with one design system stylesheet: ?system=<name>&mode=dark|light&template=<name>.",
    "scripts": {
        "build-systems": "node ../../tooling/build-system --all",
        "dev": "npm run build-systems && vite --port 5173 --strictPort",
        "build": "npm run build-systems && vite build",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@tyohnn/ui": "*",
        "lucide-react": "^1.41.0",
        "react": "^19.2.1",
        "react-dom": "^19.2.1"
    },
    "devDependencies": {
        "@tyohnn/build-system": "*",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^6.1.1",
        "typescript": "^5",
        "vite": "8.3.0"
    }
}
