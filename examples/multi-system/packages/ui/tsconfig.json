{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "jsx": "react-jsx",
        "types": [
            "node"
        ],
        "paths": {
            "@acme/ui/components/*": [
                "./src/components/*"
            ],
            "@acme/ui/lib/*": [
                "./src/lib/*"
            ],
            "@acme/ui/hooks/*": [
                "./src/hooks/*"
            ],
            "@acme/ui/icons": [
                "./src/icons/index.ts"
            ]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx"
    ],
    "exclude": [
        "node_modules"
    ]
}
