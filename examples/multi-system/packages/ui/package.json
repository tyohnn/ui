{
    "name": "@acme/ui",
    "version": "0.0.0",
    "private": true,
    "description": "shadcn components on UI SDK primitives with tyohnn design systems: one set of TSX, one CSS folder per system.",
    "exports": {
        "./components/*": "./src/components/*.tsx",
        "./hooks/*": "./src/hooks/*.ts",
        "./lib/*": "./src/lib/*.ts",
        "./icons": "./src/icons/index.ts",
        "./icons/names": "./src/icons/names.ts",
        "./strings": "./src/strings/index.ts",
        "./systems/*": "./src/systems/*"
    },
    "scripts": {
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@hugeicons/core-free-icons": "^4.3.3",
        "@hugeicons/react": "^1.1.10",
        "@shadcn/react": "^0.3.1",
        "@ui-sdk/core": "0.1.0-beta.13",
        "@ui-sdk/react": "0.1.0-beta.13",
        "class-variance-authority": "^0.7.1",
        "cn": "0.2.5",
        "lucide-react": "^1.41.0",
        "react": "^19.2.1",
        "react-dom": "^19.2.1",
        "recharts": "3.8.0",
        "shadcn": "^4.21.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "tailwindcss": "^4",
        "typescript": "^5"
    }
}
