{
    "name": "@tyohnn/mcp",
    "version": "0.0.0",
    "private": true,
    "description": "tyohnn's MCP server: explore design systems and primitives, shape a system from a concept, check it, publish it and export its files.",
    "license": "MIT",
    "type": "module",
    "exports": {
        "./http": "./src/http.ts",
        "./sessions": "./src/sessions.ts",
        "./store": "./src/store.ts",
        "./testing/contracts": "./src/testing/contracts.ts"
    },
    "bin": {
        "tyohnn-mcp": "dist/index.js"
    },
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "node build.mjs",
        "typecheck": "tsc --noEmit",
        "test": "node build.mjs && vitest run"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.1",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@modelcontextprotocol/ext-apps": "^2.0.3",
        "@types/node": "^20.19.43",
        "esbuild": "^0.28.2",
        "typescript": "^5.9.3",
        "vitest": "^5.0.1"
    }
}
