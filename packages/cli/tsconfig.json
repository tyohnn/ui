{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "types": ["node"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "resolveJsonModule": true
    },
    "include": ["src/**/*.ts", "test/**/*.ts", "e2e/**/*.ts", "vitest.config.ts"],
    "exclude": ["node_modules", "dist", "fixtures"]
}
