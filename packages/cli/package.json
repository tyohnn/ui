        "e2e": "node build.mjs && node e2e/run.mjs"
    },
    "devDependencies": {
        "@babel/parser": "^8.0.5",
        "@babel/types": "^8.0.5",
        "@clack/prompts": "^1.8.1",
        "@types/node": "^20.19.43",
        "esbuild": "^0.28.2",
        "jsonc-parser": "^3.3.1",
        "typescript": "^5.9.3",
        "vitest": "^5.0.1"
    }
}
