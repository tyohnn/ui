    "description": "Scaffold tyohnn design systems (shadcn components on Base UI with a three-layer CSS architecture) into Next.js and Vite apps and monorepos.",
    "license": "MIT",
    "type": "module",
    "bin": {
        "tyohnn": "dist/index.js"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "node build.mjs",
        "typecheck": "tsc --noEmit",
