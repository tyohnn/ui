{
    "$schema": "../schema/theme.schema.json",
    "name": "vega",
    "title": "Vega",
    "source": {
        "kind": "shadcn",
        "note": "shadcn@4.21.0 baseColor \"neutral\", plus what vega moves. tyohnn gives each ported preset its own base and chart colour so they can be told apart side by side: base neutral (the classic reference: shadcn's own neutral); charts blue, a hue near that base's tint, a different one for each preset"
    },
    "extends": {
        "base": "neutral",
        "chart": "blue"
    },
    "light": {
        "tag-blue-bg": "transparent",
        "tag-purple-bg": "transparent",
        "tag-green-bg": "transparent",
        "tag-orange-bg": "transparent",
        "tag-red-bg": "transparent",
        "tag-yellow-bg": "transparent",
        "tag-gray-bg": "transparent"
    },
    "dark": {
        "tag-blue-bg": "transparent",
        "tag-purple-bg": "transparent",
        "tag-green-bg": "transparent",
        "tag-orange-bg": "transparent",
        "tag-red-bg": "transparent",
        "tag-yellow-bg": "transparent",
        "tag-gray-bg": "transparent",
        "sidebar-primary": "var(--primary)",
        "sidebar-primary-foreground": "var(--primary-foreground)"
    }
}
