{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "types": ["node"],
        "baseUrl": ".",
        "paths": {
            "@tyohnn/components/*": ["./components/*"],
            "@tyohnn/lib/*": ["./lib/*"],
            "@tyohnn/hooks/*": ["./hooks/*"],
            "@tyohnn/icons": ["./icons/index.ts"]
        }
    },
    "include": ["components/**/*.tsx", "hooks/**/*.ts", "lib/**/*.ts", "icons/**/*.ts", "icons/**/*.tsx"],
    "exclude": ["node_modules"]
}
