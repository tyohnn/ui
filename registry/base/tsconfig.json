{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "types": ["node"],
        "baseUrl": ".",
        "paths": {
            "@tyohnn/components/*": ["./components/*"],
            "@tyohnn/lib/*": ["./lib/*"],
            "@tyohnn/hooks/*": ["./hooks/*"]
        }
    },
    "include": ["components/**/*.tsx", "hooks/**/*.ts", "lib/**/*.ts"],
    "exclude": ["node_modules"]
}
