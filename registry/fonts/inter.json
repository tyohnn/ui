{
    "$schema": "../schema/font.schema.json",
    "id": "inter",
    "family": "Inter",
    "category": "sans",
    "provider": "google",
    "next": {
        "import": "Inter",
        "variable": "--font-sans-inter"
    },
    "fontsource": {
