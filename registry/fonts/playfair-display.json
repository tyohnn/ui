{
    "$schema": "../schema/font.schema.json",
    "id": "playfair-display",
    "family": "Playfair Display",
    "category": "serif",
    "provider": "google",
    "next": {
        "import": "Playfair_Display",
        "variable": "--font-serif-playfair-display"
    },
    "fontsource": {
        "package": "@fontsource-variable/playfair-display",
        "variable": true,
        "css": "@fontsource-variable/playfair-display",
        "family": "Playfair Display Variable"
    },
    "weights": [
        400,
        500,
        600,
        700
    ],
    "axes": [
        "wght"
    ],
    "subsets": [
        "latin"
    ],
    "hangul": false,
    "license": {
        "name": "OFL-1.1",
        "url": "https://openfontlicense.org"
    }
}
