{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://tyohnn.dev/schema/theme.schema.json",
    "title": "tyohnn theme",
    "description": "registry/themes/<id>.json — one set of colour values, wearable by any system",
    "type": "object",
    "required": [
        "name",
        "title",
        "light",
        "dark"
    ],
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string"
        },
        "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "Equals the file name without .json"
        },
        "title": {
            "type": "string",
            "minLength": 1
        },
        "source": {
            "type": "object",
            "required": [
                "kind"
            ],
            "additionalProperties": false,
            "properties": {
                "kind": {
                    "enum": [
                        "shadcn",
                        "system",
                        "custom"
                    ]
                },
                "note": {
                    "type": "string"
                }
            }
        },
        "extends": {
            "type": "object",
            "additionalProperties": false,
            "description": "Layers applied before this theme's own values, in this order",
            "properties": {
                "base": {
                    "type": "string",
                    "description": "registry/themes/bases/<id>.json — the neutral ramp"
                },
                "accent": {
                    "type": "string",
                    "description": "registry/themes/accents/<id>.json — primary, secondary and the sidebar accent"
                },
                "chart": {
                    "type": "string",
                    "description": "registry/themes/accents/<id>.json — the chart ramp only"
                }
            }
        },
        "light": {
            "type": "object",
