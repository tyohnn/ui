{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://tyohnn.dev/schema/system.schema.json",
    "title": "tyohnn design system",
    "description": "registry/systems/<name>/system.json",
    "type": "object",
    "required": [
        "name",
        "description",
        "forkedFrom",
        "fonts",
        "icons",
        "tags",
        "source",
        "defaultMode",
        "tagline",
        "added"
    ],
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string"
        },
        "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "Named for the design and mood, not the use case; equals the folder name"
        },
        "description": {
            "type": "string",
            "minLength": 1
        },
        "tagline": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "description": "Three short facts joined by ' · ' (a font, a density or shape, a signature): the one line a gallery card shows"
        },
        "added": {
            "type": "string",
            "format": "date-time",
            "description": "When the system joined the registry (ISO 8601); the site lists systems newest first"
        },
        "forkedFrom": {
            "type": "object",
            "required": [
                "source",
                "commit"
            ],
            "additionalProperties": false,
            "properties": {
                "source": {
                    "type": "string"
                },
                "commit": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "note": {
                    "type": "string"
                }
            }
        },
        "fonts": {
            "$ref": "#/$defs/fonts"
        },
        "icons": {
            "$ref": "#/$defs/icons"
        },
        "defaultMode": {
            "enum": [
                "light",
                "dark"
            ],
            "description": "Colour mode an app renders by default: dark puts the `dark` class on <html>. When absent the CLI infers dark from a `dark` tag, otherwise light"
        },
        "tags": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "source": {
            "type": "object",
            "required": [
                "kind",
                "note"
            ],
            "additionalProperties": false,
            "properties": {
                "kind": {
                    "type": "string"
                },
                "note": {
                    "type": "string"
                },
                "preset": {
                    "type": "string",
                    "description": "shadcn create preset name (kind shadcn-preset)"
                },
                "shadcnVersion": {
                    "type": "string",
                    "description": "shadcn CLI version the reference app was built with"
                },
                "commit": {
                    "type": "string",
                    "description": "shadcn-ui/ui commit of that version's tag"
                }
            },
            "description": "Origin of the material. kind shadcn-preset adds preset · shadcnVersion · commit (tooling/preset/port.mjs).",
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "shadcn-preset"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "preset",
                            "shadcnVersion",
                            "commit"
                        ]
                    }
                }
            ]
        }
    },
    "$defs": {
        "fonts": {
            "type": "object",
            "required": [
                "sans",
                "heading",
                "mono",
                "hangulFallback"
            ],
            "additionalProperties": false,
            "properties": {
                "sans": {
                    "$ref": "#/$defs/fontId"
                },
                "heading": {
                    "description": "inherit: headings use the sans stack",
                    "anyOf": [
                        {
                            "const": "inherit"
                        },
                        {
                            "$ref": "#/$defs/fontId"
                        }
                    ]
                },
                "mono": {
                    "description": "system: the platform monospace stack (no font to install)",
                    "anyOf": [
                        {
                            "const": "system"
                        },
                        {
                            "$ref": "#/$defs/fontId"
                        }
                    ]
                },
                "hangulFallback": {
                    "$ref": "#/$defs/fontId"
                }
            }
        },
        "fontId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "not": {
                "enum": [
                    "inherit",
                    "system"
                ]
            },
            "description": "id of a registry/fonts/<id>.json catalog entry (existence checked by tooling/validate-system)"
        },
        "icons": {
            "type": "object",
            "required": [
                "library"
            ],
            "additionalProperties": false,
            "properties": {
                "library": {
                    "enum": [
                        "lucide",
                        "tabler",
                        "hugeicons",
                        "phosphor",
                        "remixicon",
                        "radix"
                    ],
                    "description": "Icon library @tyohnn/icons resolves to: registry/ui/icons/libraries/<library>.tsx"
                }
            }
        }
    }
}
